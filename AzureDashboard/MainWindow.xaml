<Window
    x:Class="AzureDashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AzureDashboard">

    <Grid Background="#101827"
          Padding="30"
          RowSpacing="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="AZURE DASHBOARD"
                           Foreground="#80ACF8"
                           FontSize="13"/>

                <TextBlock Text="Sensor Monitor"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="8">

                <TextBlock x:Name="ConnectionStatus"
                           Text="Disconnected"
                           Foreground="#F87171"
                           HorizontalAlignment="Right"/>

                <StackPanel Orientation="Horizontal"
                            Spacing="8">

                    <Button x:Name="ConnectButton"
                            Content="Connect"
                            Click="ConnectButton_Click"/>

                    <Button x:Name="DisconnectButton"
                            Content="Disconnect"
                            Click="DisconnectButton_Click"
                            IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Device 1 -->
        <Grid Grid.Row="1"
              ColumnSpacing="16"
              MinHeight="130">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- Device 1 information -->
            <Border Grid.Column="0"
                Background="#1D2A3C"
                CornerRadius="12"
                Padding="20">   

                <StackPanel Spacing="8"
                VerticalAlignment="Center">

                    <TextBlock x:Name="LocationText"
                   Text="Waiting for location..."
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"/>

                    <TextBlock x:Name="DeviceIdText"
                   Text="Waiting for device..."
                   Foreground="#99ABC4"
                   FontSize="13"
                   TextWrapping="Wrap"/>

                </StackPanel>
            </Border>


            <!-- Temperature -->
            <Border Grid.Column="1"
                    Background="#1D2A3C"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel Spacing="12"
                            VerticalAlignment="Center">

                    <TextBlock Text="TEMPERATURE"
                               Foreground="#FFAD72"
                               FontSize="13"/>

                    <TextBlock x:Name="TemperatureText"
                               Text="-- °C"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Humidity -->
            <Border Grid.Column="2"
                    Background="#1D2A3C"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel Spacing="12"
                            VerticalAlignment="Center">

                    <TextBlock Text="HUMIDITY"
                               Foreground="#69CBFF"
                               FontSize="13"/>

                    <TextBlock x:Name="HumidityText"
                               Text="-- %"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Device 2 -->
        <Grid Grid.Row="2"
              ColumnSpacing="16"
              MinHeight="130">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- Device 2 information -->
            <Border Grid.Column="0"
                Background="#1D2A3C"
                CornerRadius="12"
                Padding="20">

                <StackPanel Spacing="8"
                VerticalAlignment="Center">

                    <TextBlock x:Name="LocationText2"
                   Text="Waiting for location..."
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"/>

                    <TextBlock x:Name="DeviceIdText2"
                   Text="Waiting for device..."
                   Foreground="#99ABC4"
                   FontSize="13"
                   TextWrapping="Wrap"/>

                </StackPanel>
            </Border>


            <!-- Temperature -->
            <Border Grid.Column="1"
                    Background="#1D2A3C"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel Spacing="12"
                            VerticalAlignment="Center">

                    <TextBlock Text="TEMPERATURE"
                               Foreground="#FFAD72"
                               FontSize="13"/>

                    <TextBlock x:Name="TemperatureText2"
                               Text="-- °C"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Humidity -->
            <Border Grid.Column="2"
                    Background="#1D2A3C"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel Spacing="12"
                            VerticalAlignment="Center">

                    <TextBlock Text="HUMIDITY"
                               Foreground="#69CBFF"
                               FontSize="13"/>

                    <TextBlock x:Name="HumidityText2"
                               Text="-- %"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="3"
                    VerticalAlignment="Bottom"
                    Spacing="8">

            <TextBlock x:Name="GatewayText"
                       Text="Gateway: --"
                       Foreground="#99ABC4"/>

            <TextBlock x:Name="LastUpdateText"
                       Text="Last update: --"
                       Foreground="#99ABC4"/>
        </StackPanel>

    </Grid>
</Window>
