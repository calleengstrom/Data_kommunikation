<?xml version="1.0" encoding="utf-8"?>
<Window
     x:Class="BLE_app.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="#101827"
              HorizontalContentAlignment="Center"
              VerticalScrollBarVisibility="Auto">

        <Grid Padding="32"
              MaxWidth="850"
              HorizontalAlignment="Center"
              RowSpacing="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Spacing="6">

                <TextBlock Text="ESP32 DEVICE MANAGER"
                           Foreground="#80ACF8"
                           FontSize="13"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Device Configuration"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="Configure your ESP32 devices over Bluetooth Low Energy"
                           Foreground="#94A3B8"
                           FontSize="14"/>

            </StackPanel>

            <!-- BLUETOOTH CONNECTION -->
            <Border Grid.Row="1"
                    Background="#1B2638"
                    CornerRadius="12"
                    Padding="22">

                <StackPanel Spacing="16">

                    <TextBlock Text="Bluetooth Connection"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="DeviceComboBox"
                                  Header="Available Devices"
                                  PlaceholderText="Select an ESP32 device"
                                  HorizontalAlignment="Stretch"
                                  Grid.Column="0"/>

                        <Button x:Name="ScanButton"
                                Content="Scan"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                MinWidth="100"/>

                    </Grid>

                    <Grid ColumnSpacing="12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ConnectButton"
                                Content="Connect"
                                MinWidth="120"
                                Grid.Column="0"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">

                            <Ellipse x:Name="ConnectionIndicator"
                                     Width="10"
                                     Height="10"
                                     Fill="#EF4444"/>

                            <TextBlock x:Name="ConnectionStatusText"
                                       Text="Disconnected"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </Border>

            <!-- DEVICE SETTINGS -->
            <Border Grid.Row="2"
                    Background="#1B2638"
                    CornerRadius="12"
                    Padding="22">

                <StackPanel Spacing="16">

                    <TextBlock Text="Device Settings"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="DeviceIdTextBox"
                             Header="Device ID"
                             PlaceholderText="esp_temp_..."
                             IsEnabled="False"/>

                    <TextBox x:Name="LocationTextBox"
                             Header="Location"
                             PlaceholderText="Office / Livingroom"
                             IsEnabled="False"/>

                </StackPanel>

            </Border>

            <!-- WIFI SETTINGS -->
            <Border Grid.Row="3"
                    Background="#1B2638"
                    CornerRadius="12"
                    Padding="22">

                <StackPanel Spacing="16">

                    <TextBlock Text="Wi-Fi Settings"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="WifiSSIDTextBox"
                             Header="Network SSID"
                             PlaceholderText="Wi-Fi network name"
                             IsEnabled="False"/>

                    <PasswordBox x:Name="WifiPasswordBox"
                                 Header="Wi-Fi Password"
                                 PlaceholderText="Leave blank to keep existing password"
                                 IsEnabled="False"/>

                </StackPanel>

            </Border>

            <!-- MQTT SETTINGS -->
            <Border Grid.Row="4"
                    Background="#1B2638"
                    CornerRadius="12"
                    Padding="22">

                <StackPanel Spacing="16">

                    <TextBlock Text="MQTT Settings"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="MqttHostTextBox"
                                 Header="Broker Address"
                                 PlaceholderText="192.168.0.240"
                                 Grid.Column="0"
                                 IsEnabled="False"/>

                        <NumberBox x:Name="MqttPortNumberBox"
                                   Header="Port"
                                   Value="1883"
                                   Minimum="1"
                                   Maximum="65535"
                                   SpinButtonPlacementMode="Hidden"
                                   Grid.Column="1"
                                   IsEnabled="False"/>

                    </Grid>

                    <TextBox x:Name="MqttTopicTextBox"
                             Header="Publish Topic"
                             PlaceholderText="climate/data"
                             IsEnabled="False"/>

                    <TextBox x:Name="MqttUsernameTextBox"
                             Header="MQTT Username"
                             PlaceholderText="Username"
                             IsEnabled="False"/>

                    <PasswordBox x:Name="MqttPasswordBox"
                                 Header="MQTT Password"
                                 PlaceholderText="Leave blank to keep existing password"
                                 IsEnabled="False"/>

                    <Grid ColumnSpacing="12"
                          Margin="0,12,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="SaveStatusText"
                                   Text="No changes"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   Grid.Column="0"/>

                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                MinWidth="110"
                                IsEnabled="False"
                                Grid.Column="1"/>

                        <Button x:Name="SaveButton"
                                Content="Save Settings"
                                MinWidth="140"
                                IsEnabled="False"
                                Grid.Column="2"/>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</Window>
